{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(~/.ssh/**)",
      "Read(**/.ssh/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/id_ecdsa*)",
      "Read(**/id_dsa*)",
      "Edit(**/.env)",
      "Edit(**/secrets/**)",
      "Edit(~/.ssh/**)",
      "Edit(**/.ssh/**)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Bash(cat *.env*)",
      "Bash(cat */.env*)",
      "Bash(type *.env*)",
      "Bash(Get-Content *.env*)",
      "Bash(cat *.ssh*)",
      "Bash(cat *secrets/*)",
      "Bash(printenv)",
      "Bash(env)"
    ]
  }
}
