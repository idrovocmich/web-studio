secrets/
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.der
*.jks
*.keystore
id_*
*.gpg
.npmrc.local

# --- Logs ---
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Test / coverage ---
coverage/
.nyc_output/

# --- Caches ---
.cache/
.eslintcache
.prettiercache
.turbo/
.vite/

