---
import "../styles/global.css";

const title = "web-studio starter";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body class="min-h-dvh bg-neutral-50 text-neutral-900 antialiased">
    <main class="mx-auto flex max-w-2xl flex-col gap-4 px-6 py-24">
      <h1 class="text-3xl font-semibold tracking-tight">{title}</h1>
      <p class="text-neutral-600">
        Structural engine is wired up. Brand tokens and the brand contract arrive in phase 2.
      </p>
    </main>
  </body>
</html>
