---
import Footer from "@idrovocmich/sections/Footer.astro";
import Header from "@idrovocmich/sections/Header.astro";
import "../styles/global.css";
import { attributes, brand, composition, googleFontsHref, logoSrc } from "../lib/brand";
import { site } from "../lib/content";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const darkLogo = brand.logos.variants.find((v) => v.background !== "light");
const logo = {
  src: logoSrc(brand.logos.primary.file),
  alt: `${brand.name}: inicio`,
  darkSrc: darkLogo && logoSrc(darkLogo.file),
};
const fontsHref = googleFontsHref();
// `attributes` are the data-ws-* direction and composition flags the components follow.
---

<html lang="es" {...attributes}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {brand.name}</title>
    {description && <meta name="description" content={description} />}
    {fontsHref && <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />}
    {fontsHref && <link rel="stylesheet" href={fontsHref} />}
    <script is:inline>
      try {
        const saved = localStorage.getItem("ws-theme");
        if (saved === "light" || saved === "dark") document.documentElement.dataset.theme = saved;
      } catch {
        // Storage can be unavailable (private mode); fall back to the system theme.
      }
    </script>
  </head>
  <body class="min-h-dvh bg-surface-base text-content-primary antialiased">
    <Header {site} {composition} {logo} currentPath={Astro.url.pathname}>
      <button
        slot="actions"
        type="button"
        id="theme-toggle"
        class="rounded-pill border border-line-strong px-sm py-3xs text-caption"
      >
        Tema: sistema
      </button>
    </Header>
    <main>
      <slot />
    </main>
    <Footer {site} {composition} />

    <script>
      const order = ["system", "light", "dark"] as const;
      const labels = { system: "sistema", light: "claro", dark: "oscuro" };
      const button = document.getElementById("theme-toggle");
      const root = document.documentElement;
      const current = (): (typeof order)[number] =>
        root.dataset["theme"] === "light" || root.dataset["theme"] === "dark"
          ? root.dataset["theme"]
          : "system";
      const render = (): void => {
        if (button) button.textContent = `Tema: ${labels[current()]}`;
      };
      button?.addEventListener("click", () => {
        const next = order[(order.indexOf(current()) + 1) % order.length] ?? "system";
        if (next === "system") delete root.dataset["theme"];
        else root.dataset["theme"] = next;
        try {
          if (next === "system") localStorage.removeItem("ws-theme");
          else localStorage.setItem("ws-theme", next);
        } catch {
          // Storage can be unavailable (private mode); the toggle still works for this page.
        }
        render();
      });
      render();
    </script>
  </body>
</html>
