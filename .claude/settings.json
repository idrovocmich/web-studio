{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(pnpm build)",
      "Bash(pnpm lint)",
      "Bash(pnpm test)",
      "Bash(pnpm typecheck)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git branch)",
      "Bash(git branch *)",
      "PowerShell(pnpm install)",
      "PowerShell(pnpm install --frozen-lockfile)",
      "PowerShell(pnpm build)",
      "PowerShell(pnpm lint)",
      "PowerShell(pnpm test)",
      "PowerShell(pnpm typecheck)",
      "PowerShell(git status)",
      "PowerShell(git status *)",
      "PowerShell(git diff)",
      "PowerShell(git diff *)",
      "PowerShell(git log)",
      "PowerShell(git log *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git checkout *)",
      "PowerShell(git switch *)",
      "PowerShell(git branch)",
      "PowerShell(git branch *)"
    ],
    "ask": [
      "Bash(git branch -d *)",
      "Bash(git branch -D *)",
      "Bash(git branch --delete *)",
      "Bash(git branch -f *)",
      "Bash(git branch --force *)",
      "Bash(git checkout -- *)",
      "Bash(git checkout .)",
      "Bash(git checkout -f *)",
      "Bash(git checkout --force *)",
      "Bash(git switch --discard-changes *)",
      "Bash(git switch -f *)",
      "Bash(git push *)",
      "Bash(pnpm publish *)",
      "Bash(npm publish *)",
      "Bash(gh *)",
      "Bash(netlify *)",
      "PowerShell(git branch -d *)",
      "PowerShell(git branch -D *)",
      "PowerShell(git branch --delete *)",
      "PowerShell(git branch -f *)",
      "PowerShell(git branch --force *)",
      "PowerShell(git checkout -- *)",
      "PowerShell(git checkout .)",
      "PowerShell(git checkout -f *)",
      "PowerShell(git checkout --force *)",
      "PowerShell(git switch --discard-changes *)",
      "PowerShell(git switch -f *)",
      "PowerShell(git push *)",
      "PowerShell(pnpm publish *)",
      "PowerShell(npm publish *)",
      "PowerShell(gh *)",
      "PowerShell(netlify *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(~/.ssh/**)",
      "Read(**/.ssh/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/id_ecdsa*)",
      "Read(**/id_dsa*)",
      "Edit(**/.env)",
      "Edit(**/secrets/**)",
      "Edit(~/.ssh/**)",
      "Edit(**/.ssh/**)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Bash(cat *.env*)",
      "Bash(cat */.env*)",
      "Bash(type *.env*)",
      "Bash(Get-Content *.env*)",
      "Bash(cat *.ssh*)",
      "Bash(cat *secrets/*)",
      "Bash(printenv)",
      "Bash(env)",
      "Bash(git commit *--no-verify*)",
      "Bash(git commit -n *)",
      "PowerShell(Get-Content *.env*)",
      "PowerShell(cat *.env*)",
      "PowerShell(type *.env*)",
      "PowerShell(Get-Content *.ssh*)",
      "PowerShell(Get-Content *secrets*)",
      "PowerShell(Get-ChildItem env:*)",
      "PowerShell(git commit *--no-verify*)",
      "PowerShell(git commit -n *)"
    ]
  }
}
