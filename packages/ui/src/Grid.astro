---
import type { HTMLAttributes } from "astro/types";
import { gapVar, type Gap } from "./types";

interface Props extends HTMLAttributes<"div"> {
  /**
   * - "lead": the first item takes the larger column and two rows; the rest share the other.
   * - "bento": repeating pattern of large, small and wide cells.
   * - "staggered": two columns, the second offset downwards.
   * - "even": equal columns. Use it for lists, not for a row of three identical cards.
   */
  pattern?: "lead" | "bento" | "staggered" | "even";
  /** Minimum column width for "even". */
  min?: string;
  gap?: Gap;
  as?: "div" | "ul" | "ol" | "section";
}

const {
  pattern = "lead",
  min = "16rem",
  gap = "lg",
  as: Tag = "div",
  class: className,
  ...rest
} = Astro.props;
---

<Tag
  class:list={["ws-grid", className]}
  data-pattern={pattern}
  style={`--ws-grid-gap: ${gapVar(gap)}; --ws-grid-min: ${min}`}
  {...rest}
>
  <slot />
</Tag>

<style>
  .ws-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--ws-grid-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ws-grid[data-pattern="even"] {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--ws-grid-min)), 1fr));
  }

  @media (width >= 48rem) {
    .ws-grid[data-pattern="lead"] {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      grid-auto-flow: row dense;
    }
    .ws-grid[data-pattern="lead"] > :global(:first-child) {
      grid-row: span 2;
    }
    :global(:root[data-ws-asymmetry="none"]) .ws-grid[data-pattern="lead"] {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
    :global(:root[data-ws-asymmetry="strong"]) .ws-grid[data-pattern="lead"] {
      grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
    }

    .ws-grid[data-pattern="bento"] {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      grid-auto-flow: row dense;
    }
    .ws-grid[data-pattern="bento"] > :global(*) {
      grid-column: span 3;
    }
    .ws-grid[data-pattern="bento"] > :global(:nth-child(6n + 1)) {
      grid-column: span 4;
      grid-row: span 2;
    }
    .ws-grid[data-pattern="bento"] > :global(:nth-child(6n + 2)),
    .ws-grid[data-pattern="bento"] > :global(:nth-child(6n + 3)) {
      grid-column: span 2;
    }
    .ws-grid[data-pattern="bento"] > :global(:nth-child(6n)) {
      grid-column: span 6;
    }

    .ws-grid[data-pattern="staggered"] {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
    }
    .ws-grid[data-pattern="staggered"] > :global(:nth-child(even)) {
      transform: translateY(var(--ws-flow-gap-2xl));
    }
    .ws-grid[data-pattern="staggered"] {
      padding-block-end: var(--ws-flow-gap-2xl);
    }
  }
</style>
