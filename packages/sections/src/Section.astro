---
interface Props {
  type: string;
  variant: string;
  id?: string | undefined;
  /** The page's one memorable decision: it amplifies the brand's own trait. */
  signature?: boolean;
  /** Background band; "inverse" sections must keep their own text in inverse colors. */
  tone?: "base" | "subtle" | "inverse";
  as?: "section" | "header" | "footer";
  label?: string | undefined;
}

const {
  type,
  variant,
  id,
  signature = false,
  tone = "base",
  as: Tag = "section",
  label,
} = Astro.props;
---

<Tag
  class="ws-section"
  id={id}
  data-section={type}
  data-variant={variant}
  data-tone={tone}
  data-signature={signature ? "" : undefined}
  aria-label={label}
>
  <slot />
</Tag>

<style>
  .ws-section {
    /* Full rhythm on wide screens, half of it on phones. */
    --ws-section-space: clamp(
      calc(var(--ws-section-padding-y) * 0.5),
      12vw,
      var(--ws-section-padding-y)
    );
    padding-block: var(--ws-section-space);
  }
  .ws-section[data-tone="subtle"] {
    background: var(--ws-section-bg-subtle);
  }
  .ws-section[data-tone="inverse"] {
    background: var(--ws-section-bg-inverse);
    color: var(--ws-section-fg-inverse);
  }
  .ws-section[data-tone="inverse"] :global(:is(.ws-heading, .ws-text, .ws-eyebrow)) {
    color: inherit;
  }

  /*
   * Signature: the brand's own trait gets louder. Monumental brands get bigger type; organic
   * brands get bigger media; every brand gets more room.
   */
  .ws-section[data-signature] {
    padding-block: calc(var(--ws-section-space) * 1.4);
  }
  .ws-section[data-signature] :global(.ws-heading[data-size="display"]) {
    --ws-heading-scale: 1.25;
  }
  :global(:root[data-ws-heading-scale="monumental"])
    .ws-section[data-signature]
    :global(.ws-heading[data-size="display"]) {
    --ws-heading-scale: 1.7;
    max-width: none;
  }
  /* Only the first image grows, so mosaics and lists keep their rhythm. */
  :global(:root[data-ws-media="organic"])
    .ws-section[data-signature]
    :global(.ws-figure:first-of-type .ws-frame) {
    min-height: min(60vh, 40rem);
  }
</style>
