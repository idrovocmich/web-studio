{
  "$description": "Brand-independent primitives. Brand-driven primitives (color ramps, font families, type scale, radius, duration, shadow) are generated by createTokens().",
  "space": {
    "0": { "$type": "dimension", "$value": { "value": 0, "unit": "rem" } },
    "1": { "$type": "dimension", "$value": { "value": 0.25, "unit": "rem" } },
    "2": { "$type": "dimension", "$value": { "value": 0.5, "unit": "rem" } },
    "3": { "$type": "dimension", "$value": { "value": 0.75, "unit": "rem" } },
    "4": { "$type": "dimension", "$value": { "value": 1, "unit": "rem" } },
    "5": { "$type": "dimension", "$value": { "value": 1.25, "unit": "rem" } },
    "6": { "$type": "dimension", "$value": { "value": 1.5, "unit": "rem" } },
    "8": { "$type": "dimension", "$value": { "value": 2, "unit": "rem" } },
    "10": { "$type": "dimension", "$value": { "value": 2.5, "unit": "rem" } },
    "12": { "$type": "dimension", "$value": { "value": 3, "unit": "rem" } },
    "16": { "$type": "dimension", "$value": { "value": 4, "unit": "rem" } },
    "20": { "$type": "dimension", "$value": { "value": 5, "unit": "rem" } },
    "24": { "$type": "dimension", "$value": { "value": 6, "unit": "rem" } },
    "32": { "$type": "dimension", "$value": { "value": 8, "unit": "rem" } }
  },
  "border": {
    "width": {
      "thin": { "$type": "dimension", "$value": { "value": 1, "unit": "px" } },
      "thick": { "$type": "dimension", "$value": { "value": 2, "unit": "px" } },
      "heavy": { "$type": "dimension", "$value": { "value": 4, "unit": "px" } }
    }
  },
  "font": {
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold": { "$type": "fontWeight", "$value": 700 }
    },
    "leading": {
      "tight": { "$type": "number", "$value": 1.1 },
      "snug": { "$type": "number", "$value": 1.25 },
      "normal": { "$type": "number", "$value": 1.5 },
      "relaxed": { "$type": "number", "$value": 1.7 }
    },
    "tracking": {
      "tight": { "$type": "dimension", "$value": { "value": -0.02, "unit": "em" } },
      "normal": { "$type": "dimension", "$value": { "value": 0, "unit": "em" } },
      "wide": { "$type": "dimension", "$value": { "value": 0.04, "unit": "em" } },
      "wider": { "$type": "dimension", "$value": { "value": 0.08, "unit": "em" } }
    }
  },
  "breakpoint": {
    "sm": { "$type": "dimension", "$value": { "value": 40, "unit": "rem" } },
    "md": { "$type": "dimension", "$value": { "value": 48, "unit": "rem" } },
    "lg": { "$type": "dimension", "$value": { "value": 64, "unit": "rem" } },
    "xl": { "$type": "dimension", "$value": { "value": 80, "unit": "rem" } },
    "2xl": { "$type": "dimension", "$value": { "value": 96, "unit": "rem" } }
  },
  "grid": {
    "columns": {
      "compact": { "$type": "number", "$value": 4 },
      "medium": { "$type": "number", "$value": 8 },
      "wide": { "$type": "number", "$value": 12 }
    },
    "gutter": {
      "compact": { "$type": "dimension", "$value": { "value": 1, "unit": "rem" } },
      "wide": { "$type": "dimension", "$value": { "value": 1.5, "unit": "rem" } }
    },
    "margin": {
      "compact": { "$type": "dimension", "$value": { "value": 1, "unit": "rem" } },
      "wide": { "$type": "dimension", "$value": { "value": 2.5, "unit": "rem" } }
    },
    "max-width": { "$type": "dimension", "$value": { "value": 80, "unit": "rem" } },
    "prose-width": { "$type": "dimension", "$value": { "value": 42, "unit": "rem" } }
  },
  "easing": {
    "linear": { "$type": "cubicBezier", "$value": [0, 0, 1, 1] },
    "standard": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] },
    "decelerate": { "$type": "cubicBezier", "$value": [0, 0, 0.2, 1] },
    "accelerate": { "$type": "cubicBezier", "$value": [0.4, 0, 1, 1] },
    "spring": { "$type": "cubicBezier", "$value": [0.34, 1.56, 0.64, 1] }
  }
}
